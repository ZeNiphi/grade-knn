# Optional backend configuration. Copy this file to .env at the repository root if needed.
# Relative database paths are resolved from backend/, regardless of shell location.
DATABASE_PATH=app.db
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional: set a long random secret to keep existing login tokens valid after restart.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
# Development default: access tokens expire after 60 minutes.
JWT_EXPIRY_MINUTES=60

# Optional: uncomment to set/update the admin password on backend startup (8-128 characters).
# Without this setting, new admins use 12345678 and existing passwords are preserved.
# INITIAL_ADMIN_PASSWORD=your-admin-password
