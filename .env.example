# Backend only. Copy this file to .env at the repository root.
# Relative database paths are resolved from backend/, regardless of shell location.
DATABASE_PATH=app.db
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Replace this placeholder with a long random secret before running the backend.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
# Development default: access tokens expire after 60 minutes.
JWT_EXPIRY_MINUTES=60

# Used only by `python -m app.init_admin`; replace both placeholders before running it.
INITIAL_ADMIN_USERNAME=replace-with-admin-username
INITIAL_ADMIN_PASSWORD=replace-with-admin-password
